@page "/productdetails"
@using MudBlazor
@using DrawingColor = System.Drawing.Color
@using System.Drawing
@using static MudBlazor.CategoryTypes
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization;
@inject HttpClient Http
@inject ProductConfigQueryController ProdConfigController;
@inject ProductDetailQueryController ProductDetailsController;
@inject NavigationManager Navigation


<MudText Typo="Typo.h6" GutterBottom="true">Product Details @ProductConfigName</MudText>

<MudTextField @bind-Value="searchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="MudBlazor.Size.Medium" Class="mb-4" Clearable="true" OnClearButtonClick="ClearSearch"></MudTextField>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Color="Color.Error" Severity="Severity.Error">@errorMessage</MudAlert>
}
else if (filteredProductDetailsList != null && filteredProductDetailsList.Any())
{
    <MudTable Items="@filteredProductDetailsList" Dense="true" Hover="true" Bordered="true" Striped="false">
        <HeaderContent>
            <MudTh>Tester Channel</MudTh>
            <MudTh>Socket ID</MudTh>
            <MudTh>TIU Net Name</MudTh>
            <MudTh>MU Net Name</MudTh>
            <MudTh>Ballmap/Connector ID</MudTh>
        </HeaderContent>
        <RowTemplate Context="detail">
            <MudTd DataLabel="Tester Channel">@detail.ChannelNum</MudTd>
            <MudTd DataLabel="Socket ID">@detail.SocketId</MudTd>
            <MudTd DataLabel="TIU Net Name">@detail.TIUName</MudTd>
            <MudTd DataLabel="MU Net Name">@detail.MUName</MudTd>
            <MudTd DataLabel="Ballmap/Connector ID">@detail.Connector</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 15, 20, 30, 40, 50, 100, int.MaxValue }" />
        </PagerContent>
    </MudTable>
}
else
{
    <MudText>No details available.</MudText>
}

@code {

    [Parameter]
    [SupplyParameterFromQuery(Name = "productConfigName")]
    public string ProductConfigName { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "packageId")]
    public string PackageId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "testProgramName")]
    public string TestProgramName { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "tiuName")]
    public string TIUName { get; set; }

    private List<ProductDetailsModel> productDetailsList = new List<ProductDetailsModel>();
    private string searchString = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await FetchProductDetailsAsync();
    }

    private async Task FetchProductDetailsAsync()
    {
        try
        {
            var responseProdDetails = await ProductDetailsController.GetProductDetailData(PackageId, TestProgramName, TIUName);
            if (responseProdDetails.ProductDetailList != null)
            {
                foreach (var proddetails in responseProdDetails.ProductDetailList)
                {
                    var productdetailsList_ = new ProductDetailsModel
                        {
                            ChannelNum = proddetails.ChannelNumber,
                            SocketId = proddetails.SocketID,
                            TIUName = proddetails.IUNetName,
                            MUName = proddetails.MUNetName,
                            Connector = proddetails.ConnectorID,
                        };
                    productDetailsList.Add(productdetailsList_);
                }
            }
            else
            {
                errorMessage = "Failed to fetch product details.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
    }

    private void ClearSearch()
    {
        searchString = string.Empty;
    }

    private IEnumerable<ProductDetailsModel> filteredProductDetailsList => productDetailsList.Where(p =>
        string.IsNullOrEmpty(searchString) ||
        (p.ChannelNum?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (p.SocketId?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (p.TIUName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (p.MUName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (p.Connector?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    );

    public class ProductDetailsModel
    {
        public string ChannelNum { get; set; } = string.Empty;
        public string SocketId { get; set; } = string.Empty;
        public string TIUName { get; set; } = string.Empty;
        public string MUName { get; set; } = string.Empty;
        public string Connector { get; set; } = string.Empty;
    }
}
