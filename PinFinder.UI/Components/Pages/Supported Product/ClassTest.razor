        public string ChannelNum { get; set; } = string.Empty;
        public string SocketId { get; set; } = string.Empty;
        public string TIUName { get; set; } = string.Empty;
        public string MUName { get; set; } = string.Empty;
        public string Connector { get; set; } = string.Empty;
    }

    private IEnumerable<ProductClassTestModel> pagedProductList => filteredProductList
        .Skip(currentPage * rowsPerPage)
        .Take(rowsPerPage);

    protected override async Task OnInitializedAsync()
    {
        await FetchDataAsync();
    }

    private string errorMessage = string.Empty;

    public async Task FetchDataAsync()
    {
        try
        {
            var responseProdConfig = await ProdConfigController.GetProductConfigData(true);
            if (responseProdConfig.ProductConfigList != null)
            {
                foreach (var prodconfig in responseProdConfig.ProductConfigList)
                {
                    var productList_ = new ProductClassTestModel
                        {
                            ProductConfigName = prodconfig.Name,
                            PackageType = prodconfig.PackageType,
                            PackageIdSearchText = prodconfig.PackageId,
                            TestProgramSearchText = prodconfig.TestProgram,
                            InterfaceUnitIdSearchText = prodconfig.TIU,
                            InterfaceUnitDesignId = prodconfig.IUDesignId,
                            ManufacturedUnitDesignId = prodconfig.MUDesignId,
                            AdditionalAccessGroup = prodconfig.AdditionalAccessGroup,
                            // Ratio = prodconfig.PPMR,
                            // Offset = prodconfig.PPMO,
                        };
                    productList.Add(productList_);
                }
            }
            else
            {
                errorMessage = "Failed to fetch data from the Product Config controller.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
    }

    private string GetRowClass(ProductClassTestModel product, int rowNumber)
    {
        return rowNumber % 2 == 0 ? "custom-striped-row" : string.Empty;
    }

    private void ClearSearch()
    {
        searchString = string.Empty;
    }

    private async Task<TableData<ProductClassTestModel>> LoadServerData(TableState state)
    {
        currentPage = state.Page;
        rowsPerPage = state.PageSize;

        var data = new TableData<ProductClassTestModel>
            {
                Items = pagedProductList.ToList(),
                TotalItems = filteredProductList.Count()
            };

        return await Task.FromResult(data);
    }

