@page "/classtest"
@namespace PinFinder.UI.Pages
@using MudBlazor
@using PinFinder.Core.Controllers
@using PinFinder.Core.Domain.Commands.Replies
@using PinFinder.UI
@using DrawingColor = System.Drawing.Color
@using System.Drawing
@using static MudBlazor.CategoryTypes
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization;
@inject HttpClient Http
@inject ProductConfigQueryController ProdConfigController;
@inject ProductDetailQueryController ProductDetailsController;
@inject NavigationManager Navigation
@inject ProductStateService ProductState

<MudText Typo="Typo.h6" GutterBottom="true">Supported Products in Class Test</MudText>

<MudTextField @bind-Value="searchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="MudBlazor.Size.Medium" Class="mb-4" Clearable="true" OnClearButtonClick="ClearSearch"></MudTextField>
@* OnRowClick="@(args => OnRowClick(args))" *@
<MudTable Items="@filteredProductList" Dense="true" Hover="true" Bordered="true" Striped="false" RowClassFunc="GetRowClass" @bind-SelectedItem="selectedItem">
    <HeaderContent>
        <MudTh>Product Config Name</MudTh>
        <MudTh>Package Type</MudTh>
        <MudTh>Package ID</MudTh>
        <MudTh>Test Program Name</MudTh>
        <MudTh>TIU Name</MudTh>
        <MudTh>Interface Unit Design ID</MudTh>
        <MudTh>Manufactured Unit Design ID</MudTh>
        <MudTh>Additional Access Group</MudTh>
        @*  <MudTh>Package Pin Map Ratio</MudTh>
        <MudTh>Package Pin Map Offset</MudTh> *@
    </HeaderContent>
    <RowTemplate Context="product">
        <MudTd DataLabel="Product Config Name">
            <MudLink Href="@($"/productdetails?productConfigName={product.ProductConfigName}&packageId={product.PackageIdSearchText}&testProgramName={product.TestProgramSearchText}&tiuName={product.InterfaceUnitIdSearchText}")" Target="_blank">
                @product.ProductConfigName
            </MudLink>
        </MudTd>
        <MudTd DataLabel="Package Type">@product.PackageType</MudTd>
        <MudTd DataLabel="Package ID">@product.PackageIdSearchText</MudTd>
        <MudTd DataLabel="Test Program Name">@product.TestProgramSearchText</MudTd>
        <MudTd DataLabel="TIU Name">@product.InterfaceUnitIdSearchText</MudTd>
        <MudTd DataLabel="Interface Unit Design ID">@product.InterfaceUnitDesignId</MudTd>
        <MudTd DataLabel="Manufactured Unit Design ID">@product.ManufacturedUnitDesignId</MudTd>
        <MudTd DataLabel="Additional Access Group">@product.AdditionalAccessGroup</MudTd>
        @* <MudTd DataLabel="Package Pin Map Ratio">@product.Ratio</MudTd>
        <MudTd DataLabel="Package Pin Map Offset">@product.Offset</MudTd> *@
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[] { 15, 20, 30, 40, 50, 100, int.MaxValue }" />
    </PagerContent>
</MudTable>

