@page "/tiupinmap"
@namespace PinFinder.UI.Pages
@using MudBlazor
@using BlazorPanzoom
@using PinFinder.Core.Controllers
@using PinFinder.Core.Domain.Commands.Replies
@using PinFinder.UI
@using System.Text
@using System.Linq;
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components
@using System.Collections.Concurrent;
@inject IJSRuntime JSRuntime
@inject IItuffQueryController ItuffController
@inject SvgQueryController SvgController
@inject NavigationManager Navigation

<MudText Typo="Typo.h6" GutterBottom="true">TIU Pin Map</MudText>

<MudGrid Spacing="0" Class="ma-1 pa-2 d-flex flex-row flex-wrap align-center">
    <MudItem xs="6" md="3">
        <MudText Label="Socket File" Class="ma-1 pa-2" Align="Align.Left">TIu Socket and SocketID:</MudText>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudTextField @bind-Value="currentTiuSchematicSocket" Label="" ReadOnly="true" Variant="Variant.Outlined" Class="custom-label ma-1 pa-2" />
    </MudItem> 
</MudGrid>

<MudContainer Class="ma-1 pa-2">
    <MudGrid Spacing="0" Class="ma-1 pa-2 d-flex flex-row flex-wrap align-center">
        <MudItem xs="12" md="8">
            <div style="display: flex; align-items: center;">
                <MudSelect @bind-Value="selectedTIUString" Label="Select TIu Socket and SocketID" Class="mr-2">
                    @foreach (var item in tiuIds)
                    {
                        <MudSelectItem Value="@item">@item</MudSelectItem>
                    }
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="() => OnTiuIdChanged(selectedTIUString)" Disabled="@_processing" contextmenu="User" Color="Color.Primary" Size="Size.Large" Style="margin-left: 8px; font-size: 1.5rem;"> </MudIconButton>
            </div>
            <MudText Label="PinMap" Class="ma-1 pa-2" Align="Align.Left">
                Pin Map Image:
            </MudText>
            <MudCarousel Class="mx-4 my-4 rounded justify-center" @ref="_carousel" ItemsSource="@tiuIds" Style="height: 1100px; width:1500px; color:inherit;" ShowArrows="@_arrows" ShowBullets="false" AutoCycle="false"  @bind-SelectedIndex="selectedIndex" @bind-SelectedIndex:event="OnSelectedIndexChanged">
                <ItemTemplate>
                    <div style="position: relative; border: thin solid grey; width: 1200px; height: 1100px; padding: 10px; display: flex; flex-direction: column; justify-items: center; align-items: center; margin: auto; background-color: #FFFFFF;">
                        @if (context is string tiuId && TiuSvgPair.TryGetValue(tiuId, out var svgContent))
                        {
                            <div style="margin-bottom: -1px; font-weight: bold;">@tiuId</div> <!-- Label for the TiuID -->
                            <WheelZoom @key="svgContent" id="svgContainer" style="width: 100%; height: 100%; object-fit: contain;">
                                @((MarkupString)svgContent)
                            </WheelZoom>
                            <!-- Green triangle at the bottom-left corner -->
                            <svg style="position: absolute; bottom: 0; left: 0;" width="50" height="50">
                                <polygon points="0,50 50,50 0,0" style="fill: green;" />
                            </svg>
                        }
                    </div>
                </ItemTemplate>
            </MudCarousel>
        </MudItem>

        <MudItem xs="12" md="8" Class="full-height">
            <MudTable Fixed="true" Items="@uniqueConnectorList" FixedHeader="true" FixedFooter="true" Hover="true" Striped="true" Class="mt-6 full-height tiu-pin-map-table">
                <HeaderContent>
                    <MudTh Class="tiu-pin-map-table-header">TiuID</MudTh>
                    <MudTh Class="tiu-pin-map-table-header">Connector</MudTh>
                    <MudTh Class="tiu-pin-map-table-header">Count</MudTh>
                </HeaderContent>
                <RowTemplate Context="context">
                    <MudTd DataLabel="TiuID" @onmouseover="() => OnHover(context.TiuID, context.Connector)">
                        @context.TiuID.Replace("_", "")
                    </MudTd>
                    <MudTd DataLabel="Connector">@context.Connector</MudTd>
                    <MudTd DataLabel="Count">@context.Count</MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 5, 10, 15, 20, 25, 50, 100, int.MaxValue }" />
                </PagerContent>
            </MudTable>
        </MudItem>

    </MudGrid>
</MudContainer>

<MudContainer>
    <div class="color-bar" style="display: flex;">
        <div class="color-section" style="background-color: #e082c7; width: 60px; height: 15px; position: relative;">
            <span style="color: black; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 12px;">1-3</span>
        </div>
        <div class="color-section" style="background-color: #3381FF; width: 60px; height: 15px; position: relative;">
            <span style="color: black; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 12px;">4-6</span>
        </div>
        <div class="color-section" style="background-color: #00FF00; width: 60px; height: 15px; position: relative;">
            <span style="color: black; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 12px;">7-9</span>
        </div>
        <div class="color-section" style="background-color: #FFC300; width: 60px; height: 15px; position: relative;">
            <span style="color: black; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 12px;">10-12</span>
        </div>
        <div class="color-section" style="background-color: #FF9933; width: 60px; height: 15px; position: relative;">
            <span style="color: black; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 12px;">13-15</span>
        </div>
        <div class="color-section" style="background-color: #FF5733; width: 60px; height: 15px; position: relative;">
            <span style="color: white; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 12px;">16+</span>
        </div>
    </div>
</MudContainer>

<style>
    .carousel-container {
    background-color: #f0f0f0;
    padding: 16px;
    border-radius: 8px;
    height: fit-content;
    }

    .color-bar {
    display: flex;
    height: 20px;
    }

    .color-section {
    flex: 1;
    height: 100%;
    }

    .custom-label {
    font-size: 5.5rem;
    }

    .tiu-pin-map-table {
    color: white; /* Font color for the entire table */
    background-color: rgb(32,28,28);
    text-align: center; /* Center the text in the header */
    }
    .tiu-pin-map-table-header {
    background-color: rgb(72,76,92);
    color: white; /* Font color for the table header */
    font-size: 1.2rem; /* Increase the font size of the header */
    text-align: center; /* Center the text in the header */
    }
</style>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Color="Color.Error" Severity="Severity.Error">@errorMessage</MudAlert>
}
