    public static string currentTiuSchematicSocket = string.Empty;

    private bool isPanning = false;
    private double startX, startY;
    private double viewBoxX = 0, viewBoxY = 0, viewBoxWidth = 1000, viewBoxHeight = 1000;


    public class TIUSocket
    {
        public string TIUSchematicSocket { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        _carousel = new MudCarousel<string>();
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("part", out var part) && query.TryGetValue("unitTiu", out var unitTiu) && query.TryGetValue("site", out var site) && query.TryGetValue("lotID", out var lotID) && query.TryGetValue("operationID", out var operationID) && query.TryGetValue("summaryName", out var summaryName))
        {
            combinedPartUnitTiu = $"{part}_{unitTiu}";
            currentTiuSchematicSocket = combinedPartUnitTiu;
            selectedIndex = tiuIds.IndexOf(currentTiuSchematicSocket);
            if (selectedIndex == -1)
            {
                selectedIndex = 0; // Default to the first item if the TiuID is not found
            }
            await FetchDataAsync(site, lotID, operationID, summaryName);
            GenerateSvgContent(svgDataList);
            PopulateUniqueConnectorList(TiuConnectorPair);
            SetDisplay();
        }
        else
        {
            errorMessage = "Missing query parameters.";
        }
    }

    async Task FetchDataAsync(string site, string lotId, string operationId, string summaryName)
    {
        try
        {
            string package = string.Empty;
            string progname = string.Empty;
            string tiuid = string.Empty;
            string tiuDesignId = string.Empty;
            string muDesignId = string.Empty;

            var requestHeader = ItuffController.GetHeaderData(lotId, operationId, summaryName);
            var requestUnitData = ItuffController.GetUnitData(lotId, operationId, summaryName, site);

            if (requestHeader.Result?.HeaderList != null && requestUnitData.Result?.Units != null)
            {
                foreach (var header in requestHeader.Result.HeaderList)
                {
                    package = header.UniqueFolderName.Split('_')[0];
                    progname = header.UniqueFolderName.Split('_')[1];
                    if (header.UniqueFolderName.Split('_').Count() == 4)
                    {
                        tiuid = header.UniqueFolderName.Split('_')[2] + '_' + header.UniqueFolderName.Split('_')[3];
                    }
                    if (header.UniqueFolderName.Split('_').Count() == 3)
                    {
                        tiuid = header.UniqueFolderName.Split('_')[2];
                    }
                    tiuDesignId = header.IuDesignId;
                    muDesignId = header.MuDesignId;
                }
            }

            var requestSVG = SvgController.GetSvgData(tiuDesignId, muDesignId, package, progname, tiuid);
            if (requestSVG.Result?.SvgList != null)
            {
                foreach (var svgdata in requestSVG.Result.SvgList)
                {
                    svgDataList.Add(new SvgData
                        {
                            Connector = svgdata.CONNECT_NUMBER,
                            X_ = svgdata.X,
                            Y_ = svgdata.Y,
                        });
                }
            }

            if (requestUnitData.Result?.Units != null)
            {
                foreach (var unit in requestUnitData.Result.Units)
                {
                    foreach (var test in unit.Value.Tests)
                    {
                        countdataList.Add(new CombinedUnitData
                            {
                                TiuID = unit.Value.TiuId,
                                Connector = test.Connector,
                                PinName = test.PinName
                            });
                    }
                }
            }
            else
            {
                errorMessage = "Ituff Controller Query failed to be fetched";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            string a = "";

        }
    }
