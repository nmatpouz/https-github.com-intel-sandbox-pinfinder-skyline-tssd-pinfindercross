    public void SetDisplay()
    {
        selectedIndex = tiuIds.FindIndex(item => item == combinedPartUnitTiu.Split("_")[1]);
    }
    public void GenerateSvgContent(List<SvgData> svgDataList)
    {
        TiuSvgPair.Clear(); // Clear the existing SVG content list

        // Group the countdataList by TiuID
        var groupedData = countdataList.GroupBy(data => data.TiuID);
        var connectors = new List<string>();

        foreach (var data in countdataList)
        {
            data.Connector = new string(data.Connector.Distinct().ToArray());
            data.Connector = data.Connector.Replace(";", "").Replace("-", "");
        }

        Parallel.ForEach(groupedData, group =>
        {
            List<string> connectorsFromSvg = new List<string>();
            var svgBuilder = new StringBuilder();
            var tiuIdCurrent = group.First().TiuID;

            svgBuilder.AppendLine("<svg width='100%' height='100%' xmlns='http://www.w3.org/2000/svg'>");

            foreach (var svgData in svgDataList)
            {
                int rectWidthHeight = 4;
                int circleOffset = rectWidthHeight / 2;
                double circleRadDef = 3.5;
                double distanceBetweenDot = 1;

                var Xdouble = TryConvertToDouble(svgData.X_, out double resultX);
                var Ydouble = TryConvertToDouble(svgData.Y_, out double resultY);

                // Adjust the position based on the index and distanceBetweenDot
                double rectX = resultX * distanceBetweenDot;
                double rectY = resultY * distanceBetweenDot;
                double cirX = rectX + circleOffset;
                double cirY = rectY + circleOffset;

                // Draw the rectangle
                svgBuilder.AppendLine($"<rect id='{svgData.Connector}' x='{rectX}' y='{rectY}' width='{rectWidthHeight}' height='{rectWidthHeight}' fill='black' />");

                connectors = countdataList
                    .Where(data => data.TiuID == group.First().TiuID)
                    .Select(data => data.Connector)
                    .ToList();

                // Find all matching connectors in the current TiuID group and draw circles
                int matchingCount = connectors.Count(data => data.Contains(svgData.Connector.ToString()));
                if (matchingCount > 0)
                {
                    string fillColor = GetFillColor(matchingCount);
                    double circleRadScalling = matchingCount / 5;
                    if (matchingCount >= 20)
                        circleRadScalling = 4;

                    if (tiuIdCurrent == hoverTIUString && svgData.Connector == hoverConnectorString) // draw selection when hover
                        svgBuilder.AppendLine($"<circle cx='{cirX}' cy='{cirY}' r='{circleRadDef + circleRadScalling}' fill-opacity='0.6' fill='{fillColor}' stroke='black' stroke-width='1' />");
                    else
                        svgBuilder.AppendLine($"<circle cx='{cirX}' cy='{cirY}' r='{circleRadDef + circleRadScalling}' fill-opacity='0.6' fill='{fillColor}' />");

                    var repeatedConnectors = Enumerable.Repeat(svgData.Connector.ToString(), matchingCount);
                    connectorsFromSvg.AddRange(repeatedConnectors);
                }
            }
            svgBuilder.AppendLine("</svg>");

            TiuConnectorPair.AddOrUpdate(tiuIdCurrent, connectorsFromSvg, (key, existingVal) => connectorsFromSvg);
            TiuSvgPair.AddOrUpdate(tiuIdCurrent, svgBuilder.ToString(), (key, existingVal) => svgBuilder.ToString());
        });
    }
    public static bool TryConvertToDouble(string input, out double result)
    {
        // Use double.TryParse to attempt conversion
        return double.TryParse(input, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out result);
    }
    private string GetFillColor(int count)
    {
        if (count >= 1 && count <= 3)
            return "#e082c7";
        else if (count >= 4 && count <= 6)
            return "#3381FF";
        else if (count >= 7 && count <= 9)
            return "#00FF00";
        else if (count >= 10 && count <= 12)
            return "#FFC300";
        else if (count >= 13 && count <= 15)
            return "#FF9933";
        else if (count > 15)
            return "#FF5733";
        else
            return "#000000"; // Default color if count is outside the specified ranges
    }
    public void PopulateUniqueConnectorList(ConcurrentDictionary<string, List<string>> tiuConnectorPair)
    {
        // Use a ConcurrentBag to store results in a thread-safe manner
        var concurrentResults = new ConcurrentBag<CombinedTiuIdData>();

        // Clear the existing list to avoid duplicates
        uniqueConnectorList.Clear();

        // Use Parallel.ForEach for concurrent processing
        Parallel.ForEach(tiuConnectorPair, entry =>
        {
            string tiuId = entry.Key;
            List<string> connectors = entry.Value;

            // Group connectors by their name and count occurrences
            var connectorCounts = connectors.GroupBy(connector => connector)
                                    .Select(group => new CombinedTiuIdData
                                        {
                                            TiuID = tiuId,
                                            Connector = group.Key,
                                            Count = group.Count()
                                        });

            // Add the results to the ConcurrentBag
            foreach (var item in connectorCounts)
            {
                concurrentResults.Add(item);
            }
        });

        // Add the results from the ConcurrentBag to the uniqueConnectorList
        uniqueConnectorList.AddRange(concurrentResults);
    }
    private void OnHover(string tiuId, string connector)
    {
        hoverTIUString = tiuId;
        hoverConnectorString = connector;
        GenerateSvgContent(svgDataList);
    }
}


