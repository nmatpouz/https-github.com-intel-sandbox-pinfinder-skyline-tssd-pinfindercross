@page "/accessreadme"
@namespace PinFinder.UI.Pages
@using MudBlazor
@using PinFinder.Core.Controllers
@using PinFinder.Core.Domain.Commands.Replies
@using PinFinder.UI
@* @using DrawingColor = System.Drawing.Color *@
@using System.Drawing
@using static MudBlazor.CategoryTypes

<MudText Typo="Typo.h6" GutterBottom="true">Access ReadMe</MudText>
<MudText Class="mb-8">Welcome to PinFinder App, please read through below instructions to get the access either for Blue Badge or Green Badge.</MudText>
<br />

<MudGrid>
    <MudItem xs="1">
        <MudIcon Icon="@Icons.Material.Filled.Badge" Style="color: #2196F3;"  />
    </MudItem>
    <MudItem xs="11">
        <MudText Typo="Typo.h6" GutterBottom="true">Blue Badge</MudText>
    </MudItem>
</MudGrid>
<MudText Typo="Typo.body2">
    (1) Please go to left Nav Menu at Help - AGS Access - Blue Badge. Click Blue Badge it will route user to AGS Access.<br />
    (2) Select the most relevant factory site for yourself. Only request one site per user as it applies to all VF.<br />
    (3) Note: Provide a clear justification why you need the access.<br />
</MudText>
<br />
<MudGrid>
    <MudItem xs="1">
        <MudIcon Icon="@Icons.Material.Filled.Badge" Style="color: #4CAF50;" />
    </MudItem>
    <MudItem xs="11">
        <MudText Typo="Typo.h6" GutterBottom="true">Green Badge</MudText>
    </MudItem>
</MudGrid>
<MudText Typo="Typo.body2">
    (1) Please go to left Nav Menu at Help - AGS Access - Green Badge. Click Green Badge it will route user to AGS Access.<br />
    (2) Select role: <q>TMG AT CH Pinfinder Contingent Worker</q>.  This access covers all VF sites.<br />
    (3) Note: Provide a clear justification why you need the access.<br />
</MudText>

