@page "/burnin"
@using MudBlazor
@using DrawingColor = System.Drawing.Color
@using System.Drawing
@using static MudBlazor.CategoryTypes
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization;
@inject HttpClient Http

<MudText Typo="Typo.h6" GutterBottom="true">Supported Products in Burn-In Test</MudText>

<MudTable Fixed="true" T="ProductBurnInModel" Items="@productList" FixedHeader="true" FixedFooter="true" Hover="true" SortLabel="Sort By" Class="mt-4 relative">
    <HeaderContent>
        <MudTh>Product Config Name</MudTh>
        <MudTh>Package Type</MudTh>
        <MudTh>Package ID</MudTh>
        <MudTh>Test Program Name</MudTh>
        <MudTh>TIU Name</MudTh>
        <MudTh>Interface Unit Design ID</MudTh>
        <MudTh>Manufactured Unit Design ID</MudTh>
        <MudTh>Additional Access Group</MudTh>
        <MudTh>Package Pin Map Ratio</MudTh>
        <MudTh>Package Pin Map Offset</MudTh>
    </HeaderContent>
    <RowTemplate Context="product">
        <MudTd DataLabel="Product Config Name">@product.ProductConfigName</MudTd>
        <MudTd DataLabel="Package Type">@product.PackageType</MudTd>
        <MudTd DataLabel="Package ID">@product.PackageIdSearchText</MudTd>
        <MudTd DataLabel="Test Program Name">@product.TestProgramSearchText</MudTd>
        <MudTd DataLabel="TIU Name">@product.InterfaceUnitIdSearchText</MudTd>
        <MudTd DataLabel="Interface Unit Design ID">@product.InterfaceUnitDesignId</MudTd>
        <MudTd DataLabel="Manufactured Unit Design ID">@product.ManufacturedUnitDesignId</MudTd>
        <MudTd DataLabel="Additional Access Group">@product.AdditionalAccessGroup</MudTd>
        <MudTd DataLabel="Package Pin Map Ratio">@product.Ratio</MudTd>
        <MudTd DataLabel="Package Pin Map Offset">@product.Offset</MudTd>
    </RowTemplate>
</MudTable>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Color="Color.Error" Severity="Severity.Error">@errorMessage</MudAlert>
}

@code {
    private List<ProductBurnInModel> productList = new List<ProductBurnInModel>();
    private string errorMessage = string.Empty;

    public class ProductBurnInModel
    {
        public string ProductConfigName { get; set; } = string.Empty;
        public string PackageType { get; set; } = string.Empty;
        public string PackageIdSearchText { get; set; } = string.Empty;
        public string TestProgramSearchText { get; set; } = string.Empty;
        public string InterfaceUnitIdSearchText { get; set; } = string.Empty;
        public string InterfaceUnitDesignId { get; set; } = string.Empty;
        public string ManufacturedUnitDesignId { get; set; } = string.Empty;
        public string AdditionalAccessGroup { get; set; } = string.Empty;
        public string Ratio { get; set; } = string.Empty;
        public string Offset { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await FetchDataAsync();
    }

    private async Task FetchDataAsync()
    {
        using var httpClient = new HttpClient();
        var apiUrl = "https://your-api-endpoint.com/products"; // Replace here with actual API to get burn-in suppoprted product

        try
        {
            var response = await httpClient.GetAsync(apiUrl);
            if (response.IsSuccessStatusCode)
            {
                var jsonData = await response.Content.ReadAsStringAsync();
                var options = new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true,
                        //IgnoreNullValues = true,
                    };
                //productList = JsonSerializer.Serialize<List<ProductBurnInModel>>(jsonData, options);
                var productList = JsonSerializer.Deserialize<List<ProductBurnInModel>>(jsonData);
                var jsonString = JsonSerializer.Serialize(productList);
            }
            else
            {
                errorMessage = "Failed to fetch burn-in data from the API method.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
    }

}



