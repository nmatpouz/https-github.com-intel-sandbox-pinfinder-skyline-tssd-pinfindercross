    // Function to check dataRow List and do counting and row extraction into writeTable
    private void AggregateTableCount() //aggregatetablecount must receive data from dataTable gRPC response
    {
        // Dictionary to keep track of row counts based on specific columns
        Dictionary<string, int> rowCounts = new Dictionary<string, int>();

        // Specify which columns to check for it's same data in rows
        int[] columnsToCheck = { 1, 4 }; // "site","tiuid","sum","fbin","visualid","connector" columns (need to change again pnce finalize the structure)
                                         //int[] columnsToCheck2 = { 0, 1 }; // "site","tiuid"



        // Iterate through readTable to count occurrences of each row based on specific columns that have same
        foreach (var row in readTable.Skip(1))
        {
            // Create a string representation of the row based on specific columns for easy comparison
            string rowKey = string.Join(",", columnsToCheck.Select(index => row[index]));
            //string rowKey2 = string.Join(",", columnsToCheck2.Select(index => row[index]));

            if (rowCounts.ContainsKey(rowKey))
            {
                rowCounts[rowKey]++;
                count++;
            }
            else
            {
                rowCounts[rowKey] = 1;
            }
        }

        // Set to keep track of added row keys to ensure only one row instance is added to writeTable
        HashSet<string> addedRowKeys = new HashSet<string>();

        // Iterate through the list again to transfer unique rows with duplicates to writeTable
        foreach (var row in readTable.Skip(1)) // Skip header row
        {
            string rowKey = string.Join(",", columnsToCheck.Select(index => row[index]));

            if (!addedRowKeys.Contains(rowKey))
            {
                // Create a new row with the count appended as the final column
                List<string> newRow = new List<string>(row);
                newRow.Add(rowCounts[rowKey].ToString());

                // Add the new row to writeTable
                writeTable.Add(newRow);

                // Mark this row key as added
                addedRowKeys.Add(rowKey);

                // Add the unique combination of "tiuid" and "site" to the _source list
                _source.Add($"{row[0]}_{row[1]}");
            }
        }

        //_source =

