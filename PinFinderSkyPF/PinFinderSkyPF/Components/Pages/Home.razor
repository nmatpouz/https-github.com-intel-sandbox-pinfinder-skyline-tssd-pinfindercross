@page "/"
@using MudBlazor
@using PinFinderSkyPF
@using DrawingColor = System.Drawing.Color
@using System.Drawing
@using static MudBlazor.CategoryTypes
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text.Json
@using System.Collections.Generic
@* @inject GrpcService GrpcService *@
@* @inject AppState AppState *@
@inject HttpClient Http

<MudExpansionPanels Class="z-30 mb-4">
    <MudExpansionPanel Text="Filter" @bind-IsExpanded="@isExpanded">
        <TitleContent>
            <MudText>ITUFF Prober Query</MudText>
        </TitleContent>
        <ChildContent>
            <MudGrid Spacing="2" Model="filterForm"  Class="">
                @* <MudItem xs="6" md="3">
                <MudTextField @bind-Value="filterForm.Product" Label="Product" Variant="Variant.Filled" /> gap-x-8 gap-y-4 d-inline-flex flex-row flex-auto, d-flex justify-center
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudSelect @bind-Value="filterForm.Tester" Label="Tester" Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("HDMT")">HDMT</MudSelectItem>
                        <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                    </MudSelect>
                </MudItem> *@
                <MudItem xs="12" md="4" Class=""> @* OnBlur="ValidateLotNumberAndOperation" *@
                    <MudTextField @bind-Value="filterForm.LotNumber" Label="Lot Number" Variant="Variant.Filled" Required="true" For="@(() => filterForm.LotNumber)" />
                </MudItem>
                <MudItem xs="12" md="3" Class=""> @* OnBlur="ValidateLotNumberAndOperation" *@
                    <MudTextField @bind-Value="filterForm.Operation" Label="Operation" Variant="Variant.Filled" Required="true" For="@(() => filterForm.Operation)" Mask="@maskoperation"  />
                </MudItem>
                <MudItem xs="12" md="4" Class="">
                    <MudSelect @bind-Value="filterForm.Summary" For="@(() => filterForm.Summary)" Label="Summary" Variant="Variant.Filled" Disabled="@summaryEnabled">
                        @foreach (var summary in summaries)
                        {
                            <MudSelectItem Value="@summary">@summary</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <br/>
                <br/>
                @* OR
                <MudItem xs="12" md="4" Class="">
                    <MudTextField @bind-Value="filterForm.TIUID" Required="false" For="@(() => filterForm.TIUID)" Mask="@maskunitiu" Immediate="true" Label="TIU ID" Variant="Variant.Filled" />
                </MudItem> *@
                @* <MudItem xs="12" md="4" Class="">
                    <MudSelect T="string" @bind-Value="filterForm.BinSelect" MultiSelection="true" Label="Bin" Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">
                        @foreach(var bin in binlist)
                        {
                            
                            <MudSelectItem T="string" Value="@bin">@bin</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem> *@
                @* <MudItem xs="12" md="4" Class="">
                    <MudSelect @bind-Value="filterForm.Site" Required="true" For="@(() => filterForm.Site)" Label="Site" Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("ATD")">ATD</MudSelectItem>
                        <MudSelectItem Value="@("KM")">KM</MudSelectItem>
                        <MudSelectItem Value="@("PG")">PG</MudSelectItem>
                        <MudSelectItem Value="@("SS")">SS</MudSelectItem>
                        <MudSelectItem Value="@("CD")">CD</MudSelectItem>
                        <MudSelectItem Value="@("CRTO")">CRTO</MudSelectItem>
                        <MudSelectItem Value="@("KM8")">KM8</MudSelectItem>
                        <MudSelectItem Value="@(" ")">None</MudSelectItem>
                    </MudSelect>
                </MudItem> *@
            </MudGrid>
            <div class="d-flex">
                @* Disabled="@(!showResult)" *@
                <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="SearchFilter" Disabled="@searchbuttonEnabled" contextmenu="User" Color="MudBlazor.Color.Inherit" />
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="RefreshFilter" contextmenu="User" Color="MudBlazor.Color.Inherit" />
                @* <MudIconButton Icon="@Icons.Material.Filled.Save" contextmenu="User" Color="MudBlazor.Color.Inherit" /> *@
            </div>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>


@{
    if (!string.IsNullOrEmpty(errorMessage))
    {
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
}

@{
    if (showResult) {

        <MudPaper Class="pa-4 mb-2">
        <MudItem>
            <MudText Class="mr-4">Program: @headerData.Program</MudText>
        </MudItem>
        <MudItem>
            <MudText Class="mr-4">Product: @headerData.Product</MudText>
        </MudItem>
        <MudItem>
            <MudText Class="mr-4">Package: @headerData.Package</MudText>
        </MudItem>
        <MudItem>
            <MudText Class="mr-4">Step: @headerData.Step</MudText>
        </MudItem>
        <MudItem>
            <MudText Class="mr-4">Tester: @headerData.Tester</MudText>
        </MudItem>
        <MudItem>
            <MudText Class="mr-4">Temperature: @headerData.Temperature</MudText>
        </MudItem>
        <MudItem>
            <MudText Class="mr-4">TIU: @headerData.TIU</MudText>
        </MudItem>
        <MudItem>
            <MudText Class="mr-4">Socket File: @headerData.SocketFile</MudText>
        </MudItem>
        <MudItem>
            <MudText Class="mr-4">Stpl File: @headerData.StplFile</MudText>
        </MudItem>
        <MudItem>
            <MudText Class="mr-4">Env File: @headerData.EnvFile</MudText>
        </MudItem>
        <MudItem>
            <MudText Class="mr-4">PinFinder Table: @headerData.PinfinderTable</MudText>
        </MudItem>
        <MudItem>
            <MudText Class="mr-4">Warning: @headerData.Warning</MudText>
        </MudItem>
        </MudPaper>
    }
}

@{
    if (showResult) {
    <MudTable Fixed="true" T="UnitDataContent" Items="@unitDataTable" FixedHeader="true" FixedFooter="true" Hover="true" SortLabel="Sort By" Class="mt-4 relative">
        <HeaderContent>
            <MudTh>Part</MudTh>
            <MudTh>SUM</MudTh>
            <MudTh>Visual ID</MudTh>
            <MudTh>ULT</MudTh>
            <MudTh>Unit TIU</MudTh>
            <MudTh>Bin</MudTh>
            <MudTh>ITUFF Socket</MudTh>
            <MudTh>8 Digit Bin</MudTh>
            <MudTh>Tester Channel</MudTh>
            <MudTh>Measure</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Package</MudTh>
            <MudTh>Test Name</MudTh>
            <MudTh>Pattern</MudTh>
            <MudTh>Vector</MudTh>
            <MudTh>Cycle</MudTh>
            <MudTh>TIU Name</MudTh>
        </HeaderContent>
        <RowTemplate Context="context">
            <MudTd DataLabel="Part">@context.Part</MudTd>
            <MudTd DataLabel="SUM">@context.Sum</MudTd>
            <MudTd DataLabel="Visual ID">@context.VisualID</MudTd>
            <MudTd DataLabel="ULT">@context.Ult</MudTd>
            <MudTd DataLabel="Unit TIU">
                <MudLink Href="/tiupinmap" Target="_blank" @onmouseover="@(() => ShowPopupCard(context))" @onmouseout="@(() => HidePopupCard())">@context.UnitTiu</MudLink>
            </MudTd>
            <MudTd DataLabel="Bin">@context.Bin</MudTd>
            <MudTd DataLabel="ITUFF Socket">@context.ItuffSocket</MudTd>
            <MudTd DataLabel="8 Digit Bin">@context.EightDigitBin</MudTd>
            <MudTd DataLabel="Tester Channel">@context.TesterChannel</MudTd>
            <MudTd DataLabel="Measure">@context.Measure</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Package">@context.Package</MudTd>
            <MudTd DataLabel="Test Name">@context.TestName</MudTd>
            <MudTd DataLabel="Pattern">@context.Pattern</MudTd>
            <MudTd DataLabel="Vector">@context.Vector</MudTd>
            <MudTd DataLabel="Cycle">@context.Cycle</MudTd>
            <MudTd DataLabel="TIU Name">@context.TiuName</MudTd>
        </RowTemplate>
        <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100, int.MaxValue }" />
        </PagerContent>

        </MudTable>

    }
    else
    {
        // <MudProgressCircular Indeterminate="true" Color="MudBlazor.Color.Info" />
    }
}

<MudOverlay @bind-Visible="@_isPopupVisible" Position="@(_popupPosition)" Offset="@(_popupOffset)">
    <MudCard Elevation="5" Style="width: 300px;">
        <MudCardHeader>
            <MudText Typo="Typo.h6">@_popupElement.UnitTiu</MudText>
        </MudCardHeader>
        <MudCardContent>
            <MudText>Part: @_popupElement.Part</MudText>
            <MudText>Visual ID: @_popupElement.VisualID</MudText>
            <MudText>Bin: @_popupElement.Bin</MudText>
            <MudText>ITUFF Socket: @_popupElement.ItuffSocket</MudText>
            <MudText>8 Digit Bin: @_popupElement.EightDigitBin</MudText>
            <MudText>Tester Channel: @_popupElement.TesterChannel</MudText>
            <MudText>Measure: @_popupElement.Measure</MudText>
            <MudText>Name: @_popupElement.Name</MudText>
            <MudText>Package: @_popupElement.Package</MudText>
            <MudText>Test Name: @_popupElement.TestName</MudText>
            <MudText>Pattern: @_popupElement.Pattern</MudText>
            <MudText>Vector: @_popupElement.Vector</MudText>
            <MudText>Cycle: @_popupElement.Cycle</MudText>
            <MudText>TIU Name: @_popupElement.TiuName</MudText>
        </MudCardContent>
    </MudCard>
</MudOverlay>

