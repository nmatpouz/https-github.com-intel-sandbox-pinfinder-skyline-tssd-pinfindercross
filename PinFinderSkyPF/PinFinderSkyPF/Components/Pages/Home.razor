    // Button Refresh - clear all
    private void RefreshFilter()
    {
        Console.WriteLine("Refresh button clicked");

        // Create new instance to clear previous filterForm properties
        filterForm = new FilterForm(); 
        filter = new Filter();
        filterForm = new FilterForm();
        headerData = new HeaderData();
        unitData = new UnitDataContent();

        // Hide display of MudPaper of Header Data and MudTable of Unit Data
        showResult = false;

        Console.WriteLine($"Filter: Product input: {filterForm.Product}, Tester input: {filterForm.Tester}, Site input: {filterForm.Site}");
        errorMessage = string.Empty;
        summaryEnabled = false;
        summaries.Clear();
    }

    

