@page "/"
@namespace PinFinder.UI.Pages
@using MudBlazor
@using PinFinder.Core.Controllers
@using PinFinder.Core.Domain.Commands.Replies
@using PinFinder.UI
@using DrawingColor = System.Drawing.Color
@using System.Drawing
@using System.Text
@using static MudBlazor.CategoryTypes
@using System.ComponentModel.DataAnnotations
@* @using System.Net.Http.Json *@
@using System.Text.Json
@using System.Collections.Generic
@using System.Text.RegularExpressions
@inject IJSRuntime JS
@inject HttpClient Http
@inject IItuffQueryController ItuffController;
@inject SvgQueryController SvgController


<div class="announcement-banner">
    <MudPaper Elevation="1" Class="banner-paper">
        <MudText Typo="Typo.h6" Color="MudBlazor.Color.Primary" Class="text-center">
            📢 Announcement:<br>
            Please be informed PinFinder 4.0 pilot released is available for KM site only at this moment.<br>
            As PinFinder team only pilot it in KM. Other sites please use the old Pinfinder first.
        </MudText>
    </MudPaper>
</div>


<MudExpansionPanels Class="z-30 mb-4">
    <MudExpansionPanel Text="Filter" @bind-IsExpanded="@isExpanded" Disabled="@isExpandedTIU" ExpandedChanged="@OnFirstPanelToggle" >
        <TitleContent>
            <MudText>ITUFF Prober Query</MudText>
        </TitleContent>
        <ChildContent>
            <MudGrid Spacing="2" Model="filterForm" Class="">
                <!-- First Row: Site, Lot Number, Operation, Search Button -->
                <MudItem xs="12" md="2" Class="">
                    <MudSelect T="string" @ref="siteSelect" @bind-Value="filteredSite" Label="Site" Variant="Variant.Filled" MultiSelection="false" OnClearButtonClick="() => RefreshFilter()" Clearable>
                        @foreach (var site in siteList)
                        {
                            <MudSelectItem Value="@site">@site</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2" Class="">
                    <MudTextField @bind-Value="filterForm.LotNumber" Label="Lot Number" Variant="Variant.Filled" For="@(() => filterForm.LotNumber)" Class="me-2" />
                </MudItem>

                <MudItem xs="12" md="2" Class="">
                    <MudTextField @bind-Value="filterForm.Operation" Label="Operation" Variant="Variant.Filled" For="@(() => filterForm.Operation)" TextAlign="TextAlign.End" InputAttributes="@(new Dictionary<string, object> { { "dir", "ltr" } })" />
                </MudItem>
                <MudItem xs="12" md="1" Class="align-center">
                    <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="SummaryButtonClick" contextmenu="User" Color="MudBlazor.Color.Inherit" />
                </MudItem>
                <!-- Second Row: Summary, Search and Refresh Buttons -->
                <MudItem xs="12" md="3" Class="mt-2">
                    <MudSelect @bind-Value="filterForm.Summary" For="@(() => filterForm.Summary)" Label="Summary" Variant="Variant.Filled" Disabled="@summaryEnabled">
                        @foreach (var summary in summaries)
                        {
                            <MudSelectItem Value="@summary">@summary</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2" Class="mt-2">
                    @if (isLoadingSummary)
                    {
                        <MudProgressCircular Color="MudBlazor.Color.Default" Indeterminate="true" />

                    }
                </MudItem>
                <br />
                <br />
            </MudGrid>
            <MudItem xs="12" md="12" Class="mt-2 d-flex justify-content-end">
                <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="SearchTest" Disabled="@isSearchDisabled" contextmenu="User" Color="MudBlazor.Color.Inherit">
                </MudIconButton>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="RefreshFilter" contextmenu="User" Color="MudBlazor.Color.Inherit" />
            </MudItem>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

<MudExpansionPanels Class="z-30 mb-4">
    <MudExpansionPanel Text="Filter" @bind-IsExpanded="@isExpandedTIU" Disabled="@isExpanded" ExpandedChanged="@OnSecondPanelToggle">
        <TitleContent>
            <MudText>TIU Prober Query</MudText>
        </TitleContent>
        <ChildContent>
            <MudGrid Spacing="2" Model="filterForm" Class="">
                <!-- First Row: Site, Lot Number, Operation, Search Button -->
                <MudItem xs="12" md="2" Class="">
                    <MudSelect T="string" @ref="siteSelect" @bind-Value="filteredSite" Label="Site" Variant="Variant.Filled" MultiSelection="false" OnClearButtonClick="() => RefreshFilter()" Clearable>
                        @foreach (var site in siteList)
                        {
                            <MudSelectItem Value="@site">@site</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2" Class="">
                    <MudTextField @bind-Value="filterFormTIU.TIUNumber" Label="TIU Number" Variant="Variant.Filled" For="@(() => filterFormTIU.TIUNumber)" Class="me-2" />
                </MudItem>
                <MudItem xs="12" md="2" Class="mt-2">
                    @if (isLoadingTIU)
                    {
                        <MudProgressCircular Color="MudBlazor.Color.Default" Indeterminate="true" />

                    }
                </MudItem>
                <br />
                <br />
            </MudGrid>
            <MudItem xs="12" md="12" Class="mt-2 d-flex justify-content-end">
                <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="SearchByTIU" Disabled="@isSearchDisabledTIU" contextmenu="User" Color="MudBlazor.Color.Inherit">
                </MudIconButton>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="RefreshTIUQuery" contextmenu="User" Color="MudBlazor.Color.Inherit" />
            </MudItem>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>



@* Display the loading progress in linear, once the Search Icon button is clicked and done processed *@
@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-7" />
}


@* For testing purpos only when Console Writeline can't be use *@
@* <MudProgressLinear Indeterminate="true" Class="my-7" OnClick="SearchTest" /> *@




@* Display error message for any error that page having, the error string is hold  by errorMessage *@
@{
    if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
}

@{
    // Button for Export to CSV
    <div class="button-container spacing-between">
        @{
            if (showExportButton)
            {
                <MudButton OnClick="ExportData" Variant="Variant.Outlined" Color="MudBlazor.Color.Primary">Export Data</MudButton>
            }

            if (showExportButtonTIUQuery)
            {
                <MudButton OnClick="ExportDataTIUQuery" Variant="Variant.Outlined" Color="MudBlazor.Color.Primary">Export Data</MudButton>
            }
        }
    </div>
}

@* Display the Header Data output once is done processed the showResult should have value true *@
@{
