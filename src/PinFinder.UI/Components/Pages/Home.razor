                        </MudTr>
                        <MudTr>
                            <MudTd DataLabel="Field" style="font-weight: bold;">TIU</MudTd>
                            <MudTd DataLabel="Value">@context.TIU</MudTd>
                        </MudTr>
                        <MudTr>
                            <MudTd DataLabel="Field" style="font-weight: bold;">Socket File</MudTd>
                            <MudTd DataLabel="Value">@context.SocketFile</MudTd>
                        </MudTr>
                        <MudTr>
