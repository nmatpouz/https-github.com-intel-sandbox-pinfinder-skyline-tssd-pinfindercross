    // Button Search Filter
    async Task SearchByTIU()
    {
        if ((filteredSite == string.Empty && filterFormTIU.TIUNumber != null) || (filteredSite != string.Empty && filterFormTIU.TIUNumber == null))
        {
            isSearchDisabledTIU = false;
            errorMessage = "Input query is not complete, please check Site field or TIU Number field might not filled in.";
            isLoading = false;
            showExportButton = false;
            showExportButtonTIUQuery = false;
            showResult = false;
        }
        else //when both input field Site & Tiu Number is filled-in by user
        {
            // Set the flag to true to disable the MudSearch button
            isSearchDisabledTIU = true;
            errorMessage = string.Empty;
            showExportButton = false;
            showExportButtonTIUQuery = false;
            showResult = false;

            //await JS.InvokeVoidAsync("logToConsole", "Button clicked!");
            headerdataList.Clear();
            unitdataList.Clear();
            showFilterItuffProber = false;
            showFilterTIUProber = false;
            _processing = true;
            await Task.Delay(500);

            isLoading = true;
            StateHasChanged();

            string site = filteredSite;
            string tiu = filterFormTIU.TIUNumber;

            Console.WriteLine("Checking Site:" + site + " TIU Number:" + tiu);

            // Pass site and tiu number to request and get reply
            var requestUnitDatabyTIU = ItuffController.GetTiuIdUnitData(tiu, site);

            if (requestUnitDatabyTIU.Result?.Units != null) // If response of request not null
            {
                if (requestUnitDatabyTIU.Result?.Units != null)
                {
                    foreach (var unit in requestUnitDatabyTIU.Result.Units)
                    {

                        foreach (var test in unit.Value.Tests) // 1 unit can hv multiple tests, need to loop & check test of each 1 unit.
                        {
                            var combinedData = new UnitDataContent
                                {
                                    Part = unit.Value.ProductNum,
                                    Sum = unit.Value.Sum,
                                    VisualID = unit.Value.VisualId,
                                    Ult = unit.Value.Ult,
                                    UnitTiu = unit.Value.TiuId,
                                    Bin = unit.Value.Fbin,
                                    ItuffSocket = unit.Value.Site,
                                    EightDigitBin = unit.Value.EBin,
                                    TesterChannel = test.Channel,
                                    Measure = test.Measure,
                                    Name = test.PinName,
                                    Package = test.Connector,
                                    TestName = test.Tname,
                                    Pattern = test.FailPattern,
                                    Vector = test.FailVector,
                                    Cycle = test.FailCycle,
                                    TiuName = test.TiuPinName,
                                };
                            unitdataList.Add(combinedData);
                            //Console.Log(unitdataList); // Print Console.log
                            //await JS.InvokeVoidAsync("console.log", unitdataList);

                        }
                    }
                    showResult = true;
                    showFilterTIUProber = true; //Filters on top of the TIU Prober Query. this is without the TIU
                    showFilterItuffProber = false; //Filters on top of the ITUFF Prober Query. this is whole filters. set to false
                    showExportButton = false;
                    showExportButtonTIUQuery = true;
                }

            }
            else
            {
                errorMessage = "TIU query data is not exist. Please check your input query";
                showResult = false;
                _processing = false;
                isLoading = false;
                isLoadingDataTable = false;
                showExportButton = false;
                showExportButtonTIUQuery = false;
            }
            _processing = false;
            isLoading = false;
            isLoadingDataTable = false;
            //StateHasChanged();
        }

    }



