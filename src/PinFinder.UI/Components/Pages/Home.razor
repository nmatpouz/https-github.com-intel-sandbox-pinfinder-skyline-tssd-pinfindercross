    // To get data of both headerdataList and unitdataList and convert to csv
    private string ConvertToCsv<T>(IEnumerable<T> data)
    {
        var properties = typeof(T).GetProperties();
        var csvBuilder = new StringBuilder();

        // Add header line
        csvBuilder.AppendLine(string.Join(",", properties.Select(p => p.Name)));

        // Add data lines
        foreach (var item in data)
        {
            var values = properties.Select(p => p.GetValue(item, null)?.ToString() ?? string.Empty);
            csvBuilder.AppendLine(string.Join(",", values));
        }

        return csvBuilder.ToString();
    }

    // To export data of both lists
    private async Task ExportData()
    {
        showExportButton = true;
        showExportButtonTIUQuery = false;
        // Convert HeaderData to CSV first
        var headerCsv = ConvertToCsv(headerdataList);

        // Then convert UnitDataContent to CSV
        var unitDataCsv = ConvertToCsv(unitdataList);

        // Combine both CSVs with a separator
        var combinedCsv = $"Header Data\n{headerCsv}\n\nUnit Data\n{unitDataCsv}";

        // Generate the filename using Program and Product from the first HeaderData item
        var program = headerdataList.FirstOrDefault()?.Program ?? "UnknownProgram";
        var product = headerdataList.FirstOrDefault()?.Product ?? "UnknownProduct";
        var fileName = $"{program}_{product}_ExportData.csv";


        var fileBytes = Encoding.UTF8.GetBytes(combinedCsv);
        var base64 = Convert.ToBase64String(fileBytes);
        var dataUrl = $"data:text/csv;base64,{base64}";

        await JS.InvokeVoidAsync("downloadFile", dataUrl, fileName);

    }

