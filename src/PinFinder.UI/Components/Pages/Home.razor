                            <MudTd DataLabel="Field" style="font-weight: bold;">Env File</MudTd>
                            <MudTd DataLabel="Value">@context.EnvFile</MudTd>
                        </MudTr>
                    }
                </RowTemplate>
            </MudTable>
        </div>
