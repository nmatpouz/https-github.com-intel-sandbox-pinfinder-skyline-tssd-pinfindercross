    private void SortBy(string columnName)
    {
        if (currentSortColumn == columnName)
        {
            ascending = !ascending; // Toggle sort direction
        }
        else
        {
            currentSortColumn = columnName;
            ascending = true; // Default to ascending when changing columns
        }

        unitdataList = ascending
            ? unitdataList.OrderBy(x => GetPropertyValue(x, columnName)).ToList()
            : unitdataList.OrderByDescending(x => GetPropertyValue(x, columnName)).ToList();
    }

    private object GetPropertyValue(UnitDataContent item, string propertyName)
    {
        return typeof(UnitDataContent).GetProperty(propertyName).GetValue(item, null);
    }

    // Button Search Filter
    async Task SearchTest()
    {
        // Set the flag to true to disable the 2nd MudSearch button
        isSearchDisabled = true;

        //await JS.InvokeVoidAsync("logToConsole", "Button clicked!");
        headerdataList.Clear();
        _processing = true;
        await Task.Delay(500);

        isLoading = true;
        StateHasChanged();

        string site = filteredSite;
        string lotNumber = filterForm.LotNumber;
        //lotnumber_ = lotNumber;
        string operation = filterForm.Operation;
        string summary = filterForm.Summary;

        Console.WriteLine("Checking Site:" + site + " Lot Number:" + lotNumber + " Operation:" + operation + " Summary:" + summary);

        //ValidateLotNumberOperationSummary(lotnumber, operation, summary);
        //ValidateLotNumberOperationSummary(filterForm.LotNumber, filterForm.Operation, filterForm.Summary);

        // Pass lotnumber, operation and summary to request and get reply
        var requestHeader = ItuffController.GetHeaderData(lotNumber, operation, summary);
        var requestUnitData = ItuffController.GetUnitData(lotNumber, operation, summary, site);

        // variableValue = requestHeader.Result.HeaderList[0].Prgnm.ToString();

        // HeaderData list to hold HeaderList reply
        // var headerdataList = new List<HeaderData>();

        if (requestHeader.Result?.HeaderList != null && requestUnitData.Result?.Units != null) // If response of request not null for both
        {
            if (requestHeader.Result?.HeaderList != null) //If response of request not null for Header
            {
                foreach (var header in requestHeader.Result.HeaderList)
                {
                    var headerData_ = new HeaderData
                        {
                            Program = header.Prgnm,
                            Product = header.Prdct,
                            Package = header.Packg,
                        //Step = header.
                            Tester = header.TesterType,
                            Temperature = header.Tempr,
                            TIU = header.Ldbid,
                            SocketFile = header.Soc,
                            StplFile = header.Stpl,
                            EnvFile = header.Env,
                        //headerData.PinfinderTable = header.
                        //headerData.Warning = header.
                        };
                    headerdataList.Add(headerData_);
                    //Console.Log(headerdataList); // Print Console.log
                    //await JS.InvokeVoidAsync("console.log",headerdataList);


                }

                //PopulateTableData();
                showHeader = true;
            }
            if (requestUnitData.Result?.Units != null)
            {

                //var unitdataList = new List<UnitDataContent>();

                foreach (var unit in requestUnitData.Result.Units)
                {

                    foreach (var test in unit.Value.Tests) // 1 unit can hv multiple tests, need to loop & check test of each 1 unit.
                    {
                        var combinedData = new UnitDataContent
                            {
                                Part = unit.Value.ProductNum,
                                Sum = unit.Value.Sum,
                                VisualID = unit.Value.VisualId,
                                Ult = unit.Value.Ult,
                                UnitTiu = unit.Value.TiuId,
                                Bin = unit.Value.Fbin,
                                ItuffSocket = unit.Value.Site,
                                EightDigitBin = unit.Value.EBin,
                                TesterChannel = test.Channel,
                                Measure = test.Measure,
                                Name = test.PinName,
                                Package = test.Connector,
                                TestName = test.Tname,
                                Pattern = test.FailPattern,
                                Vector = test.FailVector,
                                Cycle = test.FailCycle,
                                TiuName = test.TiuPinName,
                            };
                        unitdataList.Add(combinedData);
                        //Console.Log(unitdataList); // Print Console.log
                        //await JS.InvokeVoidAsync("console.log", unitdataList);

                    }
                }
                showExportButton = true;
                showExportButtonTIUQuery = false;
                showResult = true;
                showFilterItuffProber = true;
            }

        }
        else
        {
            errorMessage = "Your query data is not exist";
            showResult = false;
            _processing = false;
            isLoading = false;
            isLoadingDataTable = false;
        }
        _processing = false;
        isLoading = false;
        isLoadingDataTable = false;
        //StateHasChanged();
